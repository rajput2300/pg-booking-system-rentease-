<body>
<% layout("/layouts/boilerplate.ejs") %>
  <%- include('partials/navbar') %>
  <div class="page-header"><div class="container"><h1>Contact Us</h1><p>We're here to help you find your perfect PG</p></div></div>
  <div class="container py-5">
    <%- include('partials/flash') %>
    <div class="row g-5 justify-content-center">
      <div class="col-lg-5">
        <h4 class="fw-700 mb-4">Get in Touch</h4>
        <div class="d-flex flex-column gap-4">
          <div class="d-flex gap-3"><div style="width:48px;height:48px;border-radius:12px;background:var(--primary-light);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0">📞</div><div><strong>Phone</strong><br><span class="text-muted">+91 98765 43210</span></div></div>
          <div class="d-flex gap-3"><div style="width:48px;height:48px;border-radius:12px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0">✉️</div><div><strong>Email</strong><br><span class="text-muted">hello@rentease.in</span></div></div>
          <div class="d-flex gap-3"><div style="width:48px;height:48px;border-radius:12px;background:#EFF6FF;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0">📍</div><div><strong>Office</strong><br><span class="text-muted">Koregaon Park, Pune, Maharashtra</span></div></div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="auth-card">
          <h5 class="fw-700 mb-4">Send us a Message</h5>
          <% if (currentUser) { %>
            <form action="/contact" method="POST">
              <div class="mb-3">
                <label class="form-label">Subject *</label>
                <input type="text" name="subject" class="form-control" placeholder="What's your query about?" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Message *</label>
                <textarea name="message" class="form-control" rows="5" placeholder="Describe your issue or query in detail..." required></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100 py-3 fw-700">
                <i class="bi bi-send me-2"></i>Send Message
              </button>
            </form>
          <% } else { %>
            <div class="text-center py-4">
              <div style="font-size: 3rem; margin-bottom: 12px;">🔐</div>
              <h6>Please login to send a message</h6>
              <p class="text-muted small">Login or create a free account to contact us</p>
              <a href="/auth/login" class="btn btn-primary">Login</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
