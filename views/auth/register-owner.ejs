<% layout("/layouts/boilerplate.ejs") %>
<body style="background: linear-gradient(135deg, #1A1F36 0%, #2D3561 50%, #0f3d2e 100%); min-height: 100vh; display: flex; align-items: center;">
  <div class="container py-5">
    <%- include('../partials/flash') %>
    <div class="row justify-content-center">
      <div class="col-md-10 col-lg-9">
        <div class="text-center mb-4">
          <a href="/" class="text-decoration-none">
            <span style="font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 800; color: white;">🏠 Rent<span style="color: var(--primary);">Ease</span>.in</span>
          </a>
          <p class="mt-1" style="color: rgba(255,255,255,0.55);">List your PG and reach thousands of students</p>
        </div>
        <div class="row g-0 overflow-hidden" style="border-radius: 24px; box-shadow: var(--shadow-lg);">
          <!-- Left Panel -->
          <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-center p-5" style="background: linear-gradient(135deg, var(--primary), #c44b1d);">
            <h2 style="font-family: 'Playfair Display', serif; font-weight: 800; color: white; font-size: 1.9rem; margin-bottom: 20px;">Become a RentEase Partner</h2>
            <div class="d-flex flex-column gap-4">
              <div class="d-flex gap-3 align-items-start">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">📢</div>
                <div>
                  <div style="color:white;font-weight:700;margin-bottom:3px">Reach 1L+ Students</div>
                  <div style="color:rgba(255,255,255,0.7);font-size:0.85rem">Get your PG in front of thousands of students actively searching</div>
                </div>
              </div>
              <div class="d-flex gap-3 align-items-start">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">📊</div>
                <div>
                  <div style="color:white;font-weight:700;margin-bottom:3px">Powerful Dashboard</div>
                  <div style="color:rgba(255,255,255,0.7);font-size:0.85rem">Manage bookings, track revenue, view reviews — all in one place</div>
                </div>
              </div>
              <div class="d-flex gap-3 align-items-start">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">✅</div>
                <div>
                  <div style="color:white;font-weight:700;margin-bottom:3px">Verified Badge</div>
                  <div style="color:rgba(255,255,255,0.7);font-size:0.85rem">Earn a verified owner badge that builds trust with tenants</div>
                </div>
              </div>
              <div class="d-flex gap-3 align-items-start">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">💰</div>
                <div>
                  <div style="color:white;font-weight:700;margin-bottom:3px">100% Free to List</div>
                  <div style="color:rgba(255,255,255,0.7);font-size:0.85rem">Zero listing fees. We only succeed when you succeed</div>
                </div>
              </div>
            </div>
          </div>
          <!-- Right: Form -->
          <div class="col-lg-7 bg-white p-5">
            <h2 class="auth-title">Register as PG Owner 🏠</h2>
            <p class="text-muted mb-4">Create your owner account — free forever</p>
            <form action="/auth/register-owner" method="POST">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Your Full Name *</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Rajesh Kumar" required>
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Business / PG Name</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shop"></i></span>
                    <input type="text" name="businessName" class="form-control" placeholder="Sunrise PG Homes">
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Email Address *</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="rajesh@example.com" required>
                  </div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone Number *</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input type="tel" name="phone" class="form-control" placeholder="+91 98765 43210" required>
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label">Password *</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Min 6 characters" minlength="6" required>
                  </div>
                </div>
              </div>

              <div class="alert mt-4 mb-3 d-flex gap-2 align-items-start" style="background: var(--accent-light); border: 1px solid rgba(0,200,150,0.3); border-radius: 12px; padding: 14px;">
                <i class="bi bi-info-circle" style="color: var(--accent); flex-shrink:0; margin-top:2px"></i>
                <div class="small" style="color: #065F46;">
                  After registration, your account will be reviewed by our team within <strong>24 hours</strong>. You can start adding PGs once approved.
                </div>
              </div>

              <button type="submit" class="btn btn-primary w-100 py-3 fw-700 mt-2">
                <i class="bi bi-shop me-2"></i>Register as Owner
              </button>
            </form>
            <hr class="my-3">
            <div class="d-flex justify-content-between align-items-center small text-muted">
              <span>Already have an account? <a href="/auth/login" style="color:var(--primary);font-weight:600">Login</a></span>
              <span>Looking for a PG? <a href="/auth/register" style="color:var(--primary);font-weight:600">Register as User</a></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
