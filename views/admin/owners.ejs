<% layout("/layouts/boilerplate.ejs") %>
<div class="admin-wrapper">
  <%- include('../partials/admin-sidebar', { activePage: 'owners' }) %>
  <div class="admin-main">
    <%- include('../partials/flash') %>
    <div class="admin-header">
      <h1>Manage Owners</h1>
      <p class="text-muted mb-0"><%= owners.length %> registered owner<%= owners.length !== 1 ? 's' : '' %></p>
    </div>

    <!-- Pending first notice -->
    <% const pending = owners.filter(o => !o.ownerApproved); %>
    <% if (pending.length > 0) { %>
      <div class="alert alert-warning d-flex align-items-center gap-3 mb-4" style="border-radius: 14px; border: none;">
        <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.5rem; color: #D97706; flex-shrink:0"></i>
        <div><strong><%= pending.length %> owner application<%= pending.length > 1 ? 's' : '' %> pending your review!</strong> Approve or reject below.</div>
      </div>
    <% } %>

    <div class="admin-table">
      <table class="table table-hover mb-0">
        <thead>
          <tr><th>Owner</th><th>Business</th><th>Phone</th><th>PGs Listed</th><th>Joined</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (owners.length > 0) { %>
            <% owners.forEach(o => { %>
              <tr style="<%= !o.ownerApproved ? 'background: #FFFBEB;' : '' %>">
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="avatar-sm" style="background: <%= o.ownerApproved ? 'var(--accent)' : '#F59E0B' %>"><%= o.username.charAt(0).toUpperCase() %></div>
                    <div>
                      <div class="fw-700 small"><%= o.username %></div>
                      <div class="text-muted" style="font-size:0.73rem"><%= o.email %></div>
                    </div>
                  </div>
                </td>
                <td><span class="small"><%= o.businessName || '—' %></span></td>
                <td><span class="text-muted small"><%= o.phone || '—' %></span></td>
                <td>
                  <span class="badge" style="background: var(--bg-light); color: var(--text-muted); border: 1px solid var(--border); border-radius: 100px; padding: 4px 10px;">
                    <%= o.pgCount %> PG<%= o.pgCount !== 1 ? 's' : '' %>
                  </span>
                </td>
                <td><span class="text-muted small"><%= new Date(o.createdAt).toLocaleDateString('en-IN') %></span></td>
                <td>
                  <% if (o.ownerApproved) { %>
                    <span class="badge" style="background: #D1FAE5; color: #065F46; border-radius: 100px; padding: 5px 12px; font-size: 0.75rem;"><i class="bi bi-patch-check-fill me-1"></i>Approved</span>
                  <% } else { %>
                    <span class="badge" style="background: #FEF3C7; color: #92400E; border-radius: 100px; padding: 5px 12px; font-size: 0.75rem;"><i class="bi bi-hourglass me-1"></i>Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (!o.ownerApproved) { %>
                    <div class="d-flex gap-1">
                      <form action="/admin/owners/<%= o._id %>/approve" method="POST">
                        <button class="btn btn-sm btn-success py-0 px-2">Approve</button>
                      </form>
                      <form action="/admin/owners/<%= o._id %>/reject" method="POST" onsubmit="return confirm('Reject and downgrade to user?')">
                        <button class="btn btn-sm btn-outline-danger py-0 px-2">Reject</button>
                      </form>
                    </div>
                  <% } else { %>
                    <form action="/admin/owners/<%= o._id %>/reject" method="POST" onsubmit="return confirm('Revoke owner status?')">
                      <button class="btn btn-sm btn-outline-secondary py-0 px-2">Revoke</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">No owner applications yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

