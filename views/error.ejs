<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><title>Error - RentEase.in</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
</head>
<body style="display: flex; align-items: center; justify-content: center; min-height: 100vh; text-align: center; background: var(--bg-light);">
  <div>
    <div style="font-size: 4rem; margin-bottom: 16px;">⚠️</div>
    <h2 class="fw-800" style="color: var(--secondary)">Something went wrong</h2>
    <p class="text-muted"><%= typeof error !== 'undefined' ? error : 'An unexpected error occurred.' %></p>
    <a href="/" class="btn btn-primary mt-3">Go Home</a>
  </div>
</body>
</html>
