<% layout("/layouts/boilerplate.ejs") %>
  <%- include('partials/navbar') %>
  <div class="page-header"><div class="container"><h1>About RentEase.in</h1><p>Making student housing simple across India</p></div></div>
  <div class="container py-5">
    <%- include('partials/flash') %>
    <div class="row align-items-center g-5 mb-5">
      <div class="col-lg-6">
        <div class="section-label mb-3">Our Story</div>
        <h2 class="section-title">Built for Students, By Students</h2>
        <p class="text-muted" style="line-height: 1.9;">RentEase.in was born out of the frustration of finding a decent PG in a new city. We've experienced firsthand the challenges of relocating for education — dealing with unreliable listings, hidden costs, and unverified landlords.</p>
        <p class="text-muted" style="line-height: 1.9;">Our mission is simple: make finding quality PG accommodation as easy as booking a movie ticket. Every listing on our platform is personally verified, ensuring you get exactly what you see.</p>
      </div>
      <div class="col-lg-6">
        <div style="background: linear-gradient(135deg, var(--primary-light), var(--accent-light)); border-radius: 24px; padding: 40px; text-align: center;">
          <div style="font-size: 6rem;">🏠</div>
          <h4 class="fw-800 mt-3">Our Values</h4>
          <div class="d-flex flex-column gap-3 text-start mt-3">
            <div class="d-flex gap-3 align-items-start"><span style="font-size: 1.3rem">✅</span><div><strong>Transparency</strong><br><span class="text-muted small">No hidden fees, no surprises</span></div></div>
            <div class="d-flex gap-3 align-items-start"><span style="font-size: 1.3rem">🛡️</span><div><strong>Safety First</strong><br><span class="text-muted small">All listings are personally verified</span></div></div>
            <div class="d-flex gap-3 align-items-start"><span style="font-size: 1.3rem">💚</span><div><strong>Community</strong><br><span class="text-muted small">Real reviews from real tenants</span></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>

