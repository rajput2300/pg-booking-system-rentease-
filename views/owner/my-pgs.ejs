<% layout("/layouts/boilerplate.ejs") %>
<div class="admin-wrapper">
  <%- include('../partials/owner-sidebar', { activePage: 'my-pgs' }) %>
  <div class="admin-main">
    <%- include('../partials/flash') %>
    <div class="admin-header d-flex justify-content-between align-items-center">
      <div>
        <h1>My PG Listings</h1>
        <p class="text-muted mb-0"><%= pgs.length %> listing<%= pgs.length !== 1 ? 's' : '' %></p>
      </div>
      <% if (currentUser.ownerApproved) { %>
        <a href="/owner/pgs/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add PG</a>
      <% } %>
    </div>

    <% if (pgs.length > 0) { %>
      <div class="admin-table">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>PG</th><th>Location</th><th>Price</th><th>Rooms</th><th>Approval Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% pgs.forEach(pg => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= pg.images?.[0] || 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=100' %>"
                      style="width: 48px; height: 48px; border-radius: 10px; object-fit: cover; flex-shrink: 0;">
                    <div>
                      <div class="fw-700 small"><%= pg.title %></div>
                      <div class="text-muted" style="font-size: 0.75rem;"><%= pg.gender %> · <%= pg.priceType %></div>
                    </div>
                  </div>
                </td>
                <td><span class="text-muted small"><%= pg.location %>, <%= pg.city %></span></td>
                <td><span class="fw-700 text-primary small">₹<%= pg.price.toLocaleString('en-IN') %>/mo</span></td>
                <td>
                  <span class="small"><%= pg.availableRooms %> avail.</span><br>
                  <span class="text-muted" style="font-size: 0.73rem;"><%= pg.totalRooms %> total</span>
                </td>
                <td>
                  <% if (pg.status === 'active') { %>
                    <span class="badge" style="background: #D1FAE5; color: #065F46; border-radius: 100px; padding: 5px 12px; font-size: 0.75rem;"><i class="bi bi-check-circle me-1"></i>Live</span>
                  <% } else if (pg.status === 'pending_approval') { %>
                    <span class="badge" style="background: #FEF3C7; color: #92400E; border-radius: 100px; padding: 5px 12px; font-size: 0.75rem;"><i class="bi bi-hourglass me-1"></i>Pending Review</span>
                  <% } else { %>
                    <span class="badge" style="background: #FEE2E2; color: #991B1B; border-radius: 100px; padding: 5px 12px; font-size: 0.75rem;"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex gap-1 flex-wrap">
                    <% if (pg.status === 'active') { %>
                      <a href="/pgs/<%= pg._id %>" class="btn btn-sm btn-outline-secondary py-0" title="View Live"><i class="bi bi-eye"></i></a>
                    <% } %>
                    <a href="/owner/pgs/<%= pg._id %>/edit" class="btn btn-sm btn-outline-primary py-0" title="Edit"><i class="bi bi-pencil"></i></a>
                    <form action="/owner/pgs/<%= pg._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this PG listing?')">
                      <button class="btn btn-sm btn-outline-danger py-0" title="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="no-results">
        <div class="icon">🏠</div>
        <h4>No PG Listings Yet</h4>
        <p class="text-muted">Start earning by listing your first PG accommodation.</p>
        <% if (currentUser.ownerApproved) { %>
          <a href="/owner/pgs/new" class="btn btn-primary mt-2"><i class="bi bi-plus-circle me-1"></i> Add Your First PG</a>
        <% } else { %>
          <p class="text-muted small mt-2">Your account is pending admin approval before you can add listings.</p>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

