<body>
<nav class="navbar navbar-expand-lg sticky-top" id="mainNav">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-icon">🏠</span>
      <span class="brand-text">Rent<span class="brand-accent">Ease</span>.in</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center gap-1">
        <li class="nav-item"><a class="nav-link" href="/pgs">Browse PGs</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
          <% } else if (currentUser.role === 'owner') { %>
            <li class="nav-item"><a class="nav-link" href="/owner/dashboard"><i class="bi bi-shop me-1"></i>Owner Panel</a></li>
            <li class="nav-item"><a class="nav-link" href="/owner/my-pgs"><i class="bi bi-building me-1"></i>My PGs</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid me-1"></i>Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/bookings/my"><i class="bi bi-calendar-check me-1"></i>Bookings</a></li>
          <% } %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
              <div class="avatar-sm"><%= currentUser.username.charAt(0).toUpperCase() %></div>
              <%= currentUser.username %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><span class="dropdown-item-text text-muted small"><%= currentUser.email %></span></li>
              <li><span class="dropdown-item-text text-muted small" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px"><%= currentUser.role %></span></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/auth/logout" method="POST">
                  <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="btn btn-outline-primary btn-sm" href="/auth/login">Login</a></li>
          <li class="nav-item"><a class="btn btn-primary btn-sm" href="/auth/register">Register</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
</body>
