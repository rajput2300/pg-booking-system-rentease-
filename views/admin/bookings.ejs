<% layout("/layouts/boilerplate.ejs") %>

  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { activePage: 'bookings' }) %>
    <div class="admin-main">
      <%- include('../partials/flash') %>
      <div class="admin-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h1>Manage Bookings</h1>
          <p class="text-muted mb-0"><%= bookings.length %> bookings found</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <% ['', 'pending', 'approved', 'rejected', 'cancelled'].forEach(s => { %>
            <a href="/admin/bookings<%= s ? '?status='+s : '' %>" class="btn btn-sm <%= filterStatus === s ? 'btn-primary' : 'btn-outline-secondary' %>">
              <%= s || 'All' %>
            </a>
          <% }) %>
        </div>
      </div>
      
      <div class="admin-table">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>User</th><th>PG</th><th>Check-In</th><th>Duration</th><th>Amount</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (bookings.length > 0) { %>
              <% bookings.forEach(b => { %>
                <tr>
                  <td>
                    <div class="fw-600 small"><%= b.user?.username %></div>
                    <div class="text-muted" style="font-size: 0.75rem;"><%= b.user?.email %></div>
                  </td>
                  <td><span class="small fw-500"><%= b.pg?.title?.substring(0,25) %></span><br><span class="text-muted" style="font-size: 0.75rem;"><%= b.pg?.city %></span></td>
                  <td><span class="small"><%= b.checkIn?.toLocaleDateString('en-IN') %></span></td>
                  <td><span class="small"><%= b.duration %> mo.</span></td>
                  <td><span class="fw-700 small">₹<%= b.totalAmount?.toLocaleString('en-IN') %></span></td>
                  <td>
                    <span class="badge" style="background: <%= b.status === 'approved' ? '#D1FAE5' : b.status === 'pending' ? '#FEF3C7' : b.status === 'rejected' ? '#FEE2E2' : '#F3F4F6' %>; color: <%= b.status === 'approved' ? '#065F46' : b.status === 'pending' ? '#92400E' : b.status === 'rejected' ? '#991B1B' : '#6B7280' %>; border-radius: 100px; padding: 5px 10px; font-size: 0.75rem;">
                      <%= b.status %>
                    </span>
                  </td>
                  <td>
                    <% if (b.status === 'pending') { %>
                      <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-success py-0" data-bs-toggle="modal" data-bs-target="#approveModal-<%= b._id %>">Approve</button>
                        <button class="btn btn-sm btn-danger py-0" data-bs-toggle="modal" data-bs-target="#rejectModal-<%= b._id %>">Reject</button>
                      </div>
                      <!-- Approve Modal -->
                      <div class="modal fade" id="approveModal-<%= b._id %>" tabindex="-1">
                        <div class="modal-dialog modal-sm">
                          <div class="modal-content">
                            <div class="modal-header"><h5 class="modal-title">Approve Booking</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                            <form action="/admin/bookings/<%= b._id %>/approve" method="POST">
                              <div class="modal-body">
                                <label class="form-label">Note to user (optional)</label>
                                <input type="text" name="note" class="form-control" placeholder="Your booking is confirmed!">
                              </div>
                              <div class="modal-footer">
                                <button type="submit" class="btn btn-success w-100">Confirm Approve</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                      <!-- Reject Modal -->
                      <div class="modal fade" id="rejectModal-<%= b._id %>" tabindex="-1">
                        <div class="modal-dialog modal-sm">
                          <div class="modal-content">
                            <div class="modal-header"><h5 class="modal-title">Reject Booking</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                            <form action="/admin/bookings/<%= b._id %>/reject" method="POST">
                              <div class="modal-body">
                                <label class="form-label">Reason for rejection</label>
                                <input type="text" name="note" class="form-control" placeholder="Room not available...">
                              </div>
                              <div class="modal-footer">
                                <button type="submit" class="btn btn-danger w-100">Confirm Reject</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" class="text-center py-5 text-muted">No bookings found</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
