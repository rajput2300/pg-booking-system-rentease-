<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { activePage: 'dashboard' }) %>
    <div class="admin-main">
      <%- include('../partials/flash') %>
      <div class="admin-header d-flex justify-content-between align-items-center">
        <div>
          <h1>Dashboard</h1>
          <p class="text-muted mb-0">Welcome back, <%= currentUser.username %>! Here's what's happening.</p>
        </div>
        <a href="/admin/pgs/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add New PG</a>
      </div>

      <!-- Stats Cards -->
      <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="stat-icon" style="background: #EFF6FF;"><i class="bi bi-building" style="color: #3B82F6"></i></div>
            <div class="stat-value"><%= stats.totalPGs %></div>
            <div class="stat-label">Total PG Listings</div>
            <% if (stats.pendingPGs > 0) { %><span class="badge bg-warning text-dark mt-1" style="font-size:0.7rem"><%= stats.pendingPGs %> pending</span><% } %>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="stat-icon" style="background: #F0FDF4;"><i class="bi bi-people" style="color: #22C55E"></i></div>
            <div class="stat-value"><%= stats.totalUsers %></div>
            <div class="stat-label">Registered Users</div>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="stat-icon" style="background: #FFF7ED;"><i class="bi bi-shop" style="color: #F97316"></i></div>
            <div class="stat-value"><%= stats.totalOwners %></div>
            <div class="stat-label">PG Owners</div>
            <% if (stats.pendingOwners > 0) { %><span class="badge bg-warning text-dark mt-1" style="font-size:0.7rem"><%= stats.pendingOwners %> pending</span><% } %>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <div class="stat-icon" style="background: #EFF6FF;"><i class="bi bi-calendar-check" style="color: #3B82F6"></i></div>
            <div class="stat-value"><%= stats.totalBookings %></div>
            <div class="stat-label">Total Bookings</div>
            <% if (stats.pendingBookings > 0) { %><span class="badge bg-warning text-dark mt-1" style="font-size:0.7rem"><%= stats.pendingBookings %> pending</span><% } %>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="stat-card">
            <div class="stat-icon" style="background: #FFF0EB;"><i class="bi bi-currency-rupee" style="color: var(--primary)"></i></div>
            <div class="stat-value" style="font-size: 1.4rem;">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></div>
            <div class="stat-label">Total Platform Revenue</div>
          </div>
        </div>
        <div class="col-6 col-lg-4">
          <div class="stat-card">
            <div class="stat-icon" style="background: #FEE2E2;"><i class="bi bi-exclamation-triangle" style="color:#DC2626"></i></div>
            <div class="stat-value"><%= stats.complaints %></div>
            <div class="stat-label">Open Complaints</div>
          </div>
        </div>
      </div>

      <!-- Recent Bookings -->
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="admin-table">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
              <h6 class="fw-700 mb-0">Recent Bookings</h6>
              <a href="/admin/bookings" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <table class="table table-hover mb-0">
              <thead><tr><th>User</th><th>PG</th><th>Date</th><th>Status</th><th>Action</th></tr></thead>
              <tbody>
                <% if (recentBookings.length > 0) { %>
                  <% recentBookings.forEach(b => { %>
                    <tr>
                      <td><span class="fw-600"><%= b.user?.username %></span></td>
                      <td><span class="text-muted small"><%= b.pg?.title?.substring(0,25) %>...</span></td>
                      <td><span class="text-muted small"><%= b.createdAt.toLocaleDateString('en-IN') %></span></td>
                      <td>
                        <span class="badge rounded-pill badge-status-<%= b.status %>"
                          style="background: <%= b.status === 'approved' ? '#D1FAE5' : b.status === 'pending' ? '#FEF3C7' : '#FEE2E2' %>; color: <%= b.status === 'approved' ? '#065F46' : b.status === 'pending' ? '#92400E' : '#991B1B' %>; font-size: 0.75rem; padding: 5px 10px;">
                          <%= b.status %>
                        </span>
                      </td>
                      <td><a href="/admin/bookings" class="btn btn-sm btn-outline-secondary py-0">Manage</a></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center text-muted py-4">No bookings yet</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="stat-card h-100">
            <h6 class="fw-700 mb-4">Quick Actions</h6>
            <div class="d-flex flex-column gap-3">
              <a href="/admin/pgs/new" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i> Add New PG</a>
              <a href="/admin/bookings?status=pending" class="btn btn-warning text-dark"><i class="bi bi-clock me-2"></i> Pending Bookings (<%= stats.pendingBookings %>)</a>
              <% if (stats.pendingPGs > 0) { %>
                <a href="/admin/pgs" class="btn" style="background:#FEF3C7;color:#92400E;border:1px solid #FCD34D"><i class="bi bi-building me-2"></i> PG Approvals (<%= stats.pendingPGs %>)</a>
              <% } %>
              <% if (stats.pendingOwners > 0) { %>
                <a href="/admin/owners" class="btn" style="background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE"><i class="bi bi-shop me-2"></i> Owner Applications (<%= stats.pendingOwners %>)</a>
              <% } %>
              <a href="/admin/owners" class="btn btn-outline-secondary"><i class="bi bi-shop me-2"></i> Manage Owners</a>
              <a href="/admin/complaints" class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle me-2"></i> Open Complaints (<%= stats.complaints %>)</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
