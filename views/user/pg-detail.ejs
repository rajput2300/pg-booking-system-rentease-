<% layout("/layouts/boilerplate.ejs") %>
  <%- include('../partials/navbar') %>

    <div class="container py-4">
      <%- include('../partials/flash') %>

        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item active"><b>
                <%= pg.title %>
              </b></li>
          </ol>
        </nav>

        <div class="row g-4">
          <!-- LEFT: Images + Details -->
          <div class="col-lg-8">

            <!-- Image Gallery with Carousel -->
            <div class="detail-images mb-4">
              <% if (pg.images && pg.images.length> 1) { %>
                <div id="pgCarousel" class="carousel slide" data-bs-ride="carousel">
                  <div class="carousel-indicators">
                    <% pg.images.forEach((img, i)=> { %>
                      <button type="button" data-bs-target="#pgCarousel" data-bs-slide-to="<%= i %>"
                        class="<%= i===0?'active':'' %>"></button>
                      <% }) %>
                  </div>
                  <div class="carousel-inner" style="border-radius:16px;overflow:hidden">
                    <% pg.images.forEach((img, i)=> { %>
                      <div class="carousel-item <%= i===0?'active':'' %>">
                        <img src="<%= img %>" class="d-block w-100" style="height:420px;object-fit:cover"
                          alt="<%= pg.title %>">
                      </div>
                      <% }) %>
                  </div>
                  <button class="carousel-control-prev" type="button" data-bs-target="#pgCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                  </button>
                  <button class="carousel-control-next" type="button" data-bs-target="#pgCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                  </button>
                </div>
                <% } else { %>
                  <img class="detail-main-img"
                    src="<%= pg.images?.[0] || 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=800' %>"
                    alt="<%= pg.title %>" style="border-radius:16px;width:100%;height:420px;object-fit:cover">
                  <% } %>
            </div>

            <!-- Info Card -->
            <div class="detail-section">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                  <h1 style="font-family:'Playfair Display',serif;font-weight:800;font-size:1.8rem;margin-bottom:4px">
                    <%= pg.title %>
                  </h1>
                  <p class="text-muted mb-2"><i class="bi bi-geo-alt-fill" style="color:var(--primary)"></i>
                    <%= pg.address %>, <%= pg.location %>, <%= pg.city %>
                  </p>
                  <% if (pg.reviewCount> 0) { %>
                    <div class="d-flex align-items-center gap-2">
                      <div class="star-rating">
                        <% for(let i=1;i<=5;i++) { %><i
                            class="bi bi-star<%= i<=Math.round(pg.rating)?'-fill':'' %>"></i>
                          <% } %>
                      </div>
                      <span class="fw-semibold">
                        <%= pg.rating %>
                      </span>
                      <span class="text-muted small">(<%= pg.reviewCount %> reviews)</span>
                    </div>
                    <% } %>
                </div>
                <div class="d-flex flex-column align-items-end gap-2">
                  <div class="pg-price">₹<%= pg.price.toLocaleString('en-IN') %> <span
                        class="text-muted fw-normal">/month</span></div>
                  <span class="badge"
                    style="background:<%= pg.availableRooms>0?'var(--accent-light)':'#FEE2E2' %>;color:<%= pg.availableRooms>0?'var(--accent)':'#DC2626' %>;font-size:0.85rem;padding:6px 12px;border-radius:100px">
                    <%= pg.availableRooms> 0 ? pg.availableRooms + ' rooms available' : 'Currently Full' %>
                  </span>
                  <!-- Wishlist Button -->
                  <% if (currentUser && currentUser.role==='user' ) { %>
                    <button id="wishlistBtn" onclick="toggleWishlist('<%= pg._id %>')"
                      class="btn btn-sm <%= isWishlisted ? 'btn-danger' : 'btn-outline-danger' %>"
                      style="border-radius:100px">
                      <i class="bi bi-heart<%= isWishlisted ? '-fill' : '' %> me-1"></i>
                      <span id="wishlistLabel">
                        <%= isWishlisted ? 'Saved' : 'Save' %>
                      </span>
                    </button>
                    <% } %>
                </div>
              </div>

              <div class="d-flex flex-wrap gap-3 py-3"
                style="border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
                <div class="text-center px-3">
                  <div class="fw-700">
                    <%= pg.gender==='co-ed' ?'👥 Co-ed':pg.gender==='male' ?'♂ Boys':'♀ Girls' %>
                  </div>
                  <div class="text-muted small">Gender</div>
                </div>
                <div class="text-center px-3">
                  <div class="fw-700">
                    <%= pg.totalRooms %>
                  </div>
                  <div class="text-muted small">Total Rooms</div>
                </div>
                <div class="text-center px-3">
                  <div class="fw-700">
                    <%= pg.priceType==='monthly' ?'Monthly':'Daily' %>
                  </div>
                  <div class="text-muted small">Billing</div>
                </div>
              </div>

              <div class="mt-4">
                <h5 class="fw-700 mb-2">About this PG</h5>
                <p class="text-muted" style="line-height:1.8">
                  <%= pg.description %>
                </p>
              </div>
            </div>

            <!-- Amenities -->
            <div class="detail-section">
              <h5 class="fw-700 mb-3">🏷️ Amenities</h5>
              <% if (pg.amenities && pg.amenities.length) { %>
                <div>
                  <% pg.amenities.forEach(a=> { %>
                    <span class="amenity-badge"><i class="bi bi-check-circle-fill"></i>
                      <%= a %>
                    </span>
                    <% }) %>
                </div>
                <% } else { %>
                  <p class="text-muted">No amenities listed.</p>
                  <% } %>
            </div>

            <!-- House Rules -->
            <% if (pg.rules && pg.rules.length) { %>
              <div class="detail-section">
                <h5 class="fw-700 mb-3">📋 House Rules</h5>
                <div class="row g-2">
                  <% pg.rules.forEach(rule=> { %>
                    <div class="col-md-6">
                      <div class="d-flex align-items-center gap-2"
                        style="background:var(--bg-light);border-radius:8px;padding:10px 14px">
                        <i class="bi bi-chevron-right" style="color:var(--primary);font-size:0.8rem"></i>
                        <span class="small">
                          <%= rule %>
                        </span>
                      </div>
                    </div>
                    <% }) %>
                </div>
              </div>
              <% } %>

                <!--Maps -->
     <script>
  const coords = <%- JSON.stringify(coordinates || []) %>;
  const pgTitle = <%- JSON.stringify(pg.title) %>;
</script>      <div id="map"></div>

                <!-- Owner Info -->
                <div class="detail-section">
                  <h5 class="fw-700 mb-3">👤 Owner / Contact</h5>
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar-sm" style="width:50px;height:50px;font-size:1.2rem">
                      <%= (pg.owner?.username||'A').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div class="fw-600">
                        <%= pg.owner?.username || 'Admin' %>
                      </div>
                      <% if (currentUser) { %>
                        <div class="text-muted small">
                          <%= pg.owner?.email %>
                        </div>
                        <% if (pg.owner?.phone) { %>
                          <div class="text-muted small"><i class="bi bi-telephone me-1"></i>
                            <%= pg.owner.phone %>
                          </div>
                          <% } %>
                            <% } else { %>
                              <div class="text-muted small"><a href="/auth/login">Login to view contact</a></div>
                              <% } %>
                    </div>
                  </div>
                </div>

                <!-- Reviews -->
                <div class="detail-section">
                  <h5 class="fw-700 mb-4">💬 Reviews (<%= reviews.length %>)</h5>

                  <!-- Write Review -->
                  <% if (currentUser && currentUser.role==='user' && !userReview) { %>
                    <div class="mb-4 p-4"
                      style="background:var(--primary-light);border-radius:16px;border:1px solid rgba(255,107,53,0.15)">
                      <h6 class="fw-700 mb-3">Write a Review</h6>
                      <form action="/reviews" method="POST">
                        <input type="hidden" name="pgId" value="<%= pg._id %>">
                        <input type="hidden" name="rating" id="ratingValue" value="5">
                        <div class="mb-3">
                          <label class="form-label fw-600">Overall Rating *</label>
                          <div class="d-flex gap-1" style="font-size:2rem;cursor:pointer">
                            <% for(let i=1;i<=5;i++) { %>
                              <span class="star-input" style="color:#f59e0b">★</span>
                              <% } %>
                          </div>
                        </div>
                        <!-- Sub ratings -->
                        <div class="row g-2 mb-3">
                          <% [['cleanliness','🧹 Cleanliness'],['food','🍽️ Food'],['location','📍Location']
                            ,['safety','🔐 Safety']].forEach(([key,label])=> { %>
                            <div class="col-6">
                              <label class="form-label fw-600 small">
                                <%= label %>
                              </label>
                              <select name="<%= key %>" class="form-select form-select-sm">
                                <option value="">Skip</option>
                                <% for(let i=1;i<=5;i++) { %>
                                  <option value="<%= i %>">
                                    <%= i %> ★
                                  </option>
                                  <% } %>
                              </select>
                            </div>
                            <% }) %>
                        </div>
                        <div class="mb-3">
                          <label class="form-label fw-600">Comment *</label>
                          <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience..."
                            required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit Review</button>
                      </form>
                    </div>
                    <% } else if (!currentUser) { %>
                      <div class="mb-4 p-3 text-center" style="background:var(--bg-light);border-radius:12px">
                        <p class="mb-2 text-muted">Login to write a review</p>
                        <a href="/auth/login" class="btn btn-primary btn-sm">Login</a>
                      </div>
                      <% } else if (userReview) { %>
                        <div class="mb-4 alert alert-success py-2">
                          <i class="bi bi-check-circle-fill me-2"></i>You've already reviewed this PG.
                        </div>
                        <% } %>

                          <!-- Reviews List -->
                          <% if (reviews.length> 0) { %>
                            <% reviews.forEach(review=> { %>
                              <div class="review-card">
                                <div class="d-flex align-items-start gap-3">
                                  <div class="review-avatar">
                                    <%= review.user?.username?.charAt(0).toUpperCase() || 'U' %>
                                  </div>
                                  <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                      <div>
                                        <div class="fw-700">
                                          <%= review.user?.username %>
                                        </div>
                                        <div class="star-rating">
                                          <% for(let i=1;i<=5;i++) { %><i
                                              class="bi bi-star<%= i<=review.rating?'-fill':'' %>"
                                              style="font-size:0.8rem"></i>
                                            <% } %>
                                              <span class="text-muted small ms-1">
                                                <%= review.rating %>/5
                                              </span>
                                        </div>
                                      </div>
                                      <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">
                                          <%= review.createdAt.toLocaleDateString('en-IN') %>
                                        </span>
                                        <% if (currentUser && (currentUser._id.toString()===review.user?._id?.toString()
                                          || currentUser.role==='admin' )) { %>
                                          <form action="/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                              style="font-size:0.75rem">Delete</button>
                                          </form>
                                          <% } %>
                                      </div>
                                    </div>
                                    <!-- Sub ratings breakdown -->
                                    <% if (review.subRatings && Object.values(review.subRatings).some(v=>v)) { %>
                                      <div class="d-flex flex-wrap gap-2 my-2">
                                        <% if (review.subRatings.cleanliness) { %><span class="amenity-tag small">🧹 <%=
                                              review.subRatings.cleanliness %>★</span>
                                          <% } %>
                                            <% if (review.subRatings.food) { %><span class="amenity-tag small">🍽️ <%=
                                                  review.subRatings.food %>★</span>
                                              <% } %>
                                                <% if (review.subRatings.location) { %><span
                                                    class="amenity-tag small">📍 <%= review.subRatings.location %>
                                                      ★</span>
                                                  <% } %>
                                                    <% if (review.subRatings.safety) { %><span
                                                        class="amenity-tag small">🔐 <%= review.subRatings.safety %>
                                                          ★</span>
                                                      <% } %>
                                      </div>
                                      <% } %>
                                        <p class="mb-0 mt-2 text-muted" style="font-size:0.95rem">
                                          <%= review.comment %>
                                        </p>
                                  </div>
                                </div>
                              </div>
                              <% }) %>
                                <% } else { %>
                                  <p class="text-muted text-center py-4">No reviews yet. Be the first to review!</p>
                                  <% } %>
                </div>

                <!-- Similar PGs -->
                <% if (similar && similar.length> 0) { %>
                  <div class="detail-section">
                    <h5 class="fw-700 mb-4">🏡 Similar PGs in <%= pg.city %>
                    </h5>
                    <div class="row g-3">
                      <% similar.forEach(s=> { %>
                        <div class="col-md-4">
                          <div class="pg-card" style="height:auto">
                            <div class="pg-card-img" style="height:140px">
                              <img
                                src="<%= s.images?.[0] || 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=400' %>"
                                alt="<%= s.title %>">
                              <span class="pg-card-gender" style="font-size:0.7rem">
                                <%= s.gender==='co-ed' ?'Co-ed':s.gender==='male' ?'♂ Boys':'♀ Girls' %>
                              </span>
                            </div>
                            <div class="pg-card-body" style="padding:14px">
                              <div class="fw-700 small mb-1">
                                <%= s.title.substring(0,35) %>
                              </div>
                              <div class="text-muted" style="font-size:0.78rem"><i class="bi bi-geo-alt-fill"
                                  style="color:var(--primary)"></i>
                                <%= s.location %>
                              </div>
                              <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="fw-800 text-primary">₹<%= s.price.toLocaleString('en-IN') %>
                                </div>
                                <a href="/pgs/<%= s._id %>" class="btn btn-sm btn-outline-primary py-0">View</a>
                              </div>
                            </div>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                  </div>
                  <% } %>
          </div>

          <!-- RIGHT: Booking Card -->
          <div class="col-lg-4">
            <div class="booking-card">
              <div class="booking-price mb-1">₹<%= pg.price.toLocaleString('en-IN') %>
              </div>
              <p class="text-muted small mb-4">per month · <%= pg.priceType==='monthly' ?'Monthly rental':'Daily rental'
                  %>
              </p>

              <% if (currentUser && currentUser.role !=='admin' && currentUser.role !=='owner' ) { %>
                <% if (userBooking) { %>
                  <div class="alert alert-success text-center">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Booking <strong>
                      <%= userBooking.status %>
                    </strong>!<br>
                    <a href="/bookings/my" class="btn btn-sm btn-success mt-2">View My Bookings</a>
                  </div>
                  <% } else if (pg.availableRooms> 0) { %>
                    <form action="/bookings" method="POST">
                      <input type="hidden" name="pgId" value="<%= pg._id %>">
                      <div class="mb-3">
                        <label class="form-label fw-600">Check-In Date</label>
                        <input type="date" name="checkIn" class="form-control" required
                          min="<%= new Date().toISOString().split('T')[0] %>">
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-600">Duration (months)</label>
                        <select name="duration" class="form-select" id="durationSelect">
                          <option value="1">1 month</option>
                          <option value="3">3 months</option>
                          <option value="6">6 months</option>
                          <option value="12">12 months</option>
                        </select>
                      </div>
                      <div class="mb-3 p-3" style="background:var(--bg-light);border-radius:12px">
                        <div class="d-flex justify-content-between mb-1">
                          <span class="text-muted">₹<%= pg.price %> × <span id="dMonths">1</span> month(s)</span>
                          <span class="fw-700" id="totalAmt">₹<%= pg.price.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                          <span>Platform fee</span><span>Free</span>
                        </div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-600">Message to Owner (optional)</label>
                        <textarea name="message" class="form-control" rows="2"
                          placeholder="Any specific requirements..."></textarea>
                      </div>
                      <button type="submit" class="btn btn-primary w-100 py-3 fw-700">
                        <i class="bi bi-calendar-check me-2"></i>Request Booking
                      </button>
                    </form>
                    <% } else { %>
                      <div class="text-center py-4">
                        <div style="font-size:3rem;margin-bottom:12px">😔</div>
                        <h6 class="fw-700">No Rooms Available</h6>
                        <p class="text-muted small">All rooms are currently occupied.</p>
                      </div>
                      <% } %>
                        <% } else if (!currentUser) { %>
                          <div class="text-center py-3">
                            <div style="font-size:3rem;margin-bottom:12px">🔐</div>
                            <h6 class="fw-700">Login to Book</h6>
                            <p class="text-muted small mb-3">Create an account to book this PG</p>
                            <a href="/auth/login" class="btn btn-primary w-100 mb-2">Login</a>
                            <a href="/auth/register" class="btn btn-outline-primary w-100">Register</a>
                          </div>
                          <% } else if (currentUser.role==='owner' ) { %>
                            <div class="alert alert-info text-center small">Owners cannot book PGs. Switch to a user
                              account.</div>
                            <% } %>

                              <hr>
                              <div class="d-flex gap-4 text-center">
                                <div class="flex-fill">
                                  <div class="fw-700 text-primary">
                                    <%= pg.totalRooms %>
                                  </div>
                                  <div class="text-muted small">Total Rooms</div>
                                </div>
                                <div class="flex-fill">
                                  <div class="fw-700 text-success">
                                    <%= pg.availableRooms %>
                                  </div>
                                  <div class="text-muted small">Available</div>
                                </div>
                                <div class="flex-fill">
                                  <div class="fw-700" style="color:#f59e0b">
                                    <%= pg.rating> 0 ? pg.rating + '★' : 'New' %>
                                  </div>
                                  <div class="text-muted small">Rating</div>
                                </div>
                              </div>
            </div>

            <div class="mt-3 text-center">
              <a href="/contact" class="text-muted small"><i class="bi bi-flag me-1"></i>Report an issue</a>
            </div>
          </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

      <script>
        const price = <%= pg.price %>;
        document.getElementById('durationSelect')?.addEventListener('change', function () {
          const months = parseInt(this.value);
          document.getElementById('dMonths').textContent = months;
          document.getElementById('totalAmt').textContent = '₹' + (price * months).toLocaleString('en-IN');
        });

        async function toggleWishlist(pgId) {
          try {
            const res = await fetch('/wishlist/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pgId })
            });
            const data = await res.json();
            const btn = document.getElementById('wishlistBtn');
            const lbl = document.getElementById('wishlistLabel');
            if (data.saved) {
              btn.classList.remove('btn-outline-danger');
              btn.classList.add('btn-danger');
              btn.querySelector('i').className = 'bi bi-heart-fill me-1';
              lbl.textContent = 'Saved';
            } else {
              btn.classList.remove('btn-danger');
              btn.classList.add('btn-outline-danger');
              btn.querySelector('i').className = 'bi bi-heart me-1';
              lbl.textContent = 'Save';
            }
          } catch (e) { console.error(e); }
        }
      </script>
      