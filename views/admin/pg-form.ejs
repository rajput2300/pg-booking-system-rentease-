<% layout("/layouts/boilerplate.ejs") %>
  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { activePage: pg ? 'pgs' : 'add-pg' }) %>
    <div class="admin-main">
      <%- include('../partials/flash') %>
      <div class="admin-header">
        <h1><%= pg ? 'Edit PG Listing' : 'Add New PG Listing' %></h1>
        <p class="text-muted"><%= pg ? 'Update the PG details below' : 'Fill in all details to list a new PG' %></p>
      </div>

      <form action="<%= pg ? '/admin/pgs/' + pg._id + '?_method=PUT' : '/admin/pgs' %>" method="POST" enctype="multipart/form-data">
        <div class="row g-4">
          <div class="col-lg-8">
            <div class="stat-card mb-4">
              <h6 class="fw-700 mb-4">Basic Information</h6>
              <div class="mb-3">
                <label class="form-label">PG Title *</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Sunrise PG for Boys" required value="<%= pg?.title || '' %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Description *</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Describe the PG, its highlights, nearby landmarks..." required><%= pg?.description || '' %></textarea>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">City *</label>
                  <input type="text" name="city" class="form-control" placeholder="e.g. Pune" required value="<%= pg?.city || '' %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Area / Location *</label>
                  <input type="text" name="location" class="form-control" placeholder="e.g. Koregaon Park" required value="<%= pg?.location || '' %>">
                </div>
                <div class="col-12">
                  <label class="form-label">Full Address *</label>
                  <input type="text" name="address" class="form-control" placeholder="Full address with landmarks" required value="<%= pg?.address || '' %>">
                </div>
              </div>
            </div>

            <div class="stat-card mb-4">
              <h6 class="fw-700 mb-4">Pricing & Rooms</h6>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label">Monthly Rent (₹) *</label>
                  <input type="number" name="price" class="form-control" placeholder="8500" required value="<%= pg?.price || '' %>">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Price Type</label>
                  <select name="priceType" class="form-select">
                    <option value="monthly" <%= pg?.priceType === 'monthly' ? 'selected' : '' %>>Monthly</option>
                    <option value="daily" <%= pg?.priceType === 'daily' ? 'selected' : '' %>>Daily</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Gender *</label>
                  <select name="gender" class="form-select" required>
                    <option value="">Select...</option>
                    <option value="male" <%= pg?.gender === 'male' ? 'selected' : '' %>>Boys Only</option>
                    <option value="female" <%= pg?.gender === 'female' ? 'selected' : '' %>>Girls Only</option>
                    <option value="co-ed" <%= pg?.gender === 'co-ed' ? 'selected' : '' %>>Co-ed</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Total Rooms</label>
                  <input type="number" name="totalRooms" class="form-control" value="<%= pg?.totalRooms || 1 %>" min="1">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Available Rooms</label>
                  <input type="number" name="availableRooms" class="form-control" value="<%= pg?.availableRooms || 1 %>" min="0">
                </div>
              </div>
            </div>

            <div class="stat-card mb-4">
              <h6 class="fw-700 mb-4">Amenities</h6>
              <div class="row">
                <% ['Wi-Fi', 'AC', 'Meals Included', 'Laundry', 'Parking', 'Hot Water', 'TV', 'Security', 'CCTV', 'Gym', 'Housekeeping', 'Power Backup'].forEach(a => { %>
                  <div class="col-6 col-md-4">
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="amenities" value="<%= a %>" id="am-<%= a %>"
                        <%= pg?.amenities?.includes(a) ? 'checked' : '' %>>
                      <label class="form-check-label" for="am-<%= a %>"><%= a %></label>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="stat-card">
              <h6 class="fw-700 mb-4">House Rules</h6>
              <div id="rules-container">
                <% (pg?.rules || ['No smoking', 'No pets']).forEach((rule, i) => { %>
                  <div class="input-group mb-2">
                    <input type="text" name="rules" class="form-control" value="<%= rule %>" placeholder="e.g. No smoking">
                    <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
                  </div>
                <% }) %>
              </div>
              <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addRule()">
                <i class="bi bi-plus me-1"></i>Add Rule
              </button>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="stat-card mb-4">
              <h6 class="fw-700 mb-4">Images</h6>
              <div class="mb-3">
                <label class="form-label">Upload Images (max 5)</label>
                <input type="file" name="images" class="form-control" multiple accept="image/*">
                <div class="form-text">Supports JPG, PNG, WebP. Max 5MB each.</div>
              </div>
              <% if (pg?.images?.length) { %>
                <div class="mt-3">
                  <label class="form-label small text-muted">Current Images</label>
                  <div class="row g-2">
                    <% pg.images.forEach(img => { %>
                      <div class="col-6">
                        <img src="<%= img %>" style="width: 100%; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border);">
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </div>

            <div class="stat-card mb-4">
              <h6 class="fw-700 mb-4">Settings</h6>
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="featured" id="featured" <%= pg?.featured ? 'checked' : '' %>>
                <label class="form-check-label fw-600" for="featured">Featured Listing</label>
                <div class="form-text">Featured PGs appear on the homepage</div>
              </div>
              <% if (pg) { %>
                <div class="mb-3">
                  <label class="form-label fw-600">Status</label>
                  <select name="status" class="form-select">
                    <option value="active" <%= pg.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%= pg.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>
              <% } %>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-fill py-3 fw-700">
                <i class="bi bi-check2 me-2"></i><%= pg ? 'Update PG' : 'Add PG' %>
              </button>
              <a href="/admin/pgs" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    function addRule() {
      const container = document.getElementById('rules-container');
      const div = document.createElement('div');
      div.className = 'input-group mb-2';
      div.innerHTML = `<input type="text" name="rules" class="form-control" placeholder="e.g. No alcohol">
        <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>`;
      container.appendChild(div);
    }
  </script>
</body>
</html>
