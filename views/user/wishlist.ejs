<% layout("/layouts/boilerplate.ejs") %>
  <%- include('../partials/navbar') %>
  <div class="page-header">
    <div class="container">
      <h1><i class="bi bi-heart-fill me-2"></i>My Wishlist</h1>
      <p>PGs you've saved for later</p>
    </div>
  </div>
  <div class="container py-5">
    <%- include('../partials/flash') %>
    <% if (wishlist.length > 0) { %>
      <div class="row g-4">
        <% wishlist.forEach(pg => { %>
          <div class="col-md-6 col-lg-4">
            <div class="pg-card">
              <div class="pg-card-img">
                <img src="<%= pg.images && pg.images.length ? pg.images[0] : 'https://images.unsplash.com/photo-1555854877-bab0e564b8d5?w=600' %>" alt="<%= pg.title %>">
                <span class="pg-card-badge" style="background: <%= pg.availableRooms > 0 ? 'var(--accent)' : '#EF4444' %>">
                  <%= pg.availableRooms > 0 ? pg.availableRooms + ' Available' : 'Full' %>
                </span>
              </div>
              <div class="pg-card-body">
                <h5 class="pg-card-title"><%= pg.title %></h5>
                <p class="pg-card-location"><i class="bi bi-geo-alt-fill" style="color:var(--primary)"></i> <%= pg.location %>, <%= pg.city %></p>
                <div class="pg-card-footer">
                  <div class="pg-price">₹<%= pg.price.toLocaleString('en-IN') %> <span>/mo</span></div>
                  <div class="d-flex gap-2">
                    <a href="/pgs/<%= pg._id %>" class="btn btn-primary btn-sm">View</a>
                    <form action="/bookings/wishlist/<%= pg._id %>" method="POST">
                      <button class="btn btn-outline-danger btn-sm" title="Remove"><i class="bi bi-heart-fill"></i></button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-results">
        <div class="icon">❤️</div>
        <h4>Your wishlist is empty</h4>
        <p class="text-muted">Browse PGs and click the heart to save your favourites.</p>
        <a href="/pgs" class="btn btn-primary mt-2">Browse PGs</a>
      </div>
    <% } %>
  </div>
  <%- include('../partials/footer') %>
